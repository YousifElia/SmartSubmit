# A sync server built into your own builds of SmartSubmit (optional). Without
# these, people enter their server on the Sync page instead. Both values are
# public by design: data is protected by each account and its encryption.
#
# Put them in .env.production.local so test builds stay unconfigured.
WXT_SUPABASE_URL=https://your-project.supabase.co
WXT_SUPABASE_KEY=sb_publishable_...
